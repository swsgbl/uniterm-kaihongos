== env.sh ==
#!/system/bin/sh
# Device toolchain env — unpack into /data/local/home then:
#   . /data/local/home/env.sh
#
# Layout:
#   $HOME/env.sh
#   $HOME/.local/bin/          CLIs (pack_hap, hvigorw, hdc, es2abc, ...)
#   $HOME/.ohos/sdk            OpenHarmony SDK
#   $HOME/.ohos/deveco_sdk     DevEco layout (default/openharmony -> ../sdk)
#   $HOME/.ohos/{hvigor,ohpm,node,signature,...}

# Resolve home root from this file's location.
_ENV_SELF="$0"
case "$_ENV_SELF" in
  */*) _ENV_DIR="$(CDPATH= cd -- "$(dirname "$_ENV_SELF")" && pwd)" ;;
  *) _ENV_DIR="$(pwd)" ;;
esac
if [ -f "$_ENV_DIR/env.sh" ] || [ -d "$_ENV_DIR/.ohos" ]; then
  HOME_ROOT="$_ENV_DIR"
elif [ -d /data/local/home/.ohos ]; then
  HOME_ROOT="/data/local/home"
else
  HOME_ROOT="${HOME:-/data/local/home}"
fi
unset _ENV_SELF _ENV_DIR

export HOME="$HOME_ROOT"
export OHOS_HOME="${OHOS_HOME:-$HOME/.ohos}"
# Back-compat alias used by older scripts / docs.
export KH_EXT="${KH_EXT:-$HOME}"

# Bundled Node — no agent_env required.
if [ -z "${DEVECO_NODE_HOME:-}" ]; then
  if [ -x "$OHOS_HOME/node/bin/node" ]; then
    export DEVECO_NODE_HOME="$OHOS_HOME/node"
  fi
fi
export NODE_HOME="${NODE_HOME:-$DEVECO_NODE_HOME}"

# Agent/sandbox (non-shell UID) often cannot mprotect RWX → V8 SIGTRAP at Isolate::Initialize.
